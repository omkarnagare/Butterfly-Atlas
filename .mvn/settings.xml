<?xml version="1.0" encoding="UTF-8"?>
<!--
  Intentionally empty: isolates this personal project from machine-wide
  (e.g. corporate) mirrors, servers and credentials in ~/.m2/settings.xml,
  so all builds resolve from Maven Central.
  Maven resolves this path from the current directory, so run ./mvnw from the
  repository root (use -pl <module> to target a module).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd"/>
